      "parameters": {
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"robots\" content=\"noindex, nofollow\">\n<meta name=\"referrer\" content=\"no-referrer\">\n<title>FINMENTOR — B21C Gateway Test</title>\n<script src=\"https://telegram.org/js/telegram-web-app.js\"></script>\n<style>\n  :root{--navy:#0d1b2a;--graphite:#1b2735;--line:#2a3a4d;--gold:#c9a227;--off:#f4f1ea;--muted:#8fa0b3;--ok:#2e7d5b;--bad:#a33a3a}\n  *{box-sizing:border-box;margin:0;padding:0}\n  body{background:var(--navy);color:var(--off);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;padding:22px 18px calc(22px + env(safe-area-inset-bottom));min-height:100vh}\n  .eyebrow{font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);margin-bottom:8px}\n  h1{font-family:Georgia,serif;font-size:20px;font-weight:600;margin-bottom:6px}\n  p.sub{color:var(--muted);font-size:13px;line-height:1.5;margin-bottom:18px}\n  .card{background:var(--graphite);border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:10px}\n  .head{display:flex;align-items:center;gap:9px;margin-bottom:9px}\n  .dot{width:9px;height:9px;border-radius:50%;background:var(--muted);flex:0 0 auto}\n  .dot.ok{background:var(--ok)}\n  .dot.bad{background:var(--bad)}\n  .title{font-size:14px;font-weight:600}\n  dl{display:grid;grid-template-columns:auto 1fr;gap:5px 12px;font-size:12px}\n  dt{color:var(--muted)}\n  dd{font-family:ui-monospace,Menlo,monospace;word-break:break-all}\n  .note{font-size:11px;color:var(--muted);line-height:1.5;margin-top:14px}\n  #prog{font-family:ui-monospace,Menlo,monospace;font-size:12px;color:var(--gold);margin-bottom:12px}\n  .warn{border:1px solid rgba(201,162,39,.35);border-radius:10px;padding:12px;margin-bottom:14px;font-size:12px;line-height:1.55;color:var(--gold)}\n</style>\n</head>\n<body>\n<div class=\"eyebrow\">B.2.1-C · Gateway Live Proof</div>\n<h1>Проверка Mini App Gateway</h1>\n<p class=\"sub\">Три проверки одного подписанного контекста. Лид не создаётся, эксперту ничего не передаётся, анкета не открывается.</p>\n<div class=\"warn\">Не закрывайте эту страницу до конца третьей проверки (около 16 минут). Держите экран включённым и Telegram на переднем плане.</div>\n<div id=\"prog\">Запуск…</div>\n<div id=\"out\"></div>\n<p class=\"note\" id=\"note\"></p>\n<script>\n(function () {\n  'use strict';\n\n  // The CURRENT deployed Gateway. Same origin as this page, so the browser issues no CORS\n  // preflight and the Gateway needs no CORS change - which is exactly why this page is served\n  // from n8n and not from www.finmentor.md.\n  var ENDPOINT = 'https://ghennadi.app.n8n.cloud/webhook/finmentor-miniapp-gateway';\n\n  var CLIENT_VERSION = 'b2.1.0';\n  var LOCALE = 'ru';\n\n  // ---------------------------------------------------------------- the three shots\n  //\n  // ONE genuine Telegram-signed context, sent three times, unchanged. The browser is the only\n  // place it can safely live: holding it here for the freshness window means it is never\n  // written to n8n, GitHub, Sheets or any store, and no human ever reads it.\n  //\n  //   A  immediately              expect 200  ok:true, app_session_id issued, G5 row +1\n  //   B  right after A            expect 409  REPLAY_REFUSED, G5 row count unchanged\n  //   C  auth_date + >900s        expect 401  TG_INITDATA_EXPIRED, G5 never reached\n  //\n  // The Gateway verifies the Ed25519 signature BEFORE freshness, and claims the replay key\n  // only after both pass. So C fails at the freshness gate with the signature still valid,\n  // which is the one gate P9 could not prove live: TG_INITDATA_EXPIRED is emitted at exactly\n  // one place in the verifier, and reaching it means the claim node was never touched.\n\n  // Measured from shot A, not from auth_date, so the page never parses the signed context.\n  // auth_date is always <= the moment A is sent, so A + 940s is always past auth_date + 900s.\n  // Only clock RATE matters here, not the browser's absolute clock offset.\n  var STALE_DELAY_MS = 940000;\n\n  // If any of these ever appears in a Gateway response, TB-1 has leaked. Checked at every\n  // nesting depth, not just the top level.\n  var FORBIDDEN = ['init_data','initData','signature','hash','replay_key','submission_key',\n                   'telegram_user_id','lead_id','canonical_lead_id','cycle_id','consent',\n                   'mode','lead_mode','credential','token','bot_token','row_number','id'];\n\n  var out = document.getElementById('out');\n  var note = document.getElementById('note');\n  var prog = document.getElementById('prog');\n\n  function card(title, kind, rows) {\n    var c = document.createElement('div'); c.className = 'card';\n    var h = document.createElement('div'); h.className = 'head';\n    var d = document.createElement('span'); d.className = 'dot' + (kind ? ' ' + kind : '');\n    var t = document.createElement('span'); t.className = 'title'; t.textContent = title;\n    h.appendChild(d); h.appendChild(t); c.appendChild(h);\n    var dl = document.createElement('dl');\n    for (var i = 0; i < rows.length; i++) {\n      if (rows[i][1] === undefined || rows[i][1] === null || rows[i][1] === '') { continue; }\n      var a = document.createElement('dt'); a.textContent = rows[i][0];\n      var b = document.createElement('dd'); b.textContent = String(rows[i][1]);\n      dl.appendChild(a); dl.appendChild(b);\n    }\n    c.appendChild(dl); out.appendChild(c);\n  }\n\n  function scan(obj, found, depth) {\n    if (obj === null || typeof obj !== 'object' || depth > 8) { return found; }\n    var k = Object.keys(obj);\n    for (var i = 0; i < k.length; i++) {\n      if (FORBIDDEN.indexOf(k[i]) !== -1 && found.indexOf(k[i]) === -1) { found.push(k[i]); }\n      scan(obj[k[i]], found, depth + 1);\n    }\n    return found;\n  }\n\n  var tg = window.Telegram && window.Telegram.WebApp ? window.Telegram.WebApp : null;\n  if (!tg) {\n    prog.textContent = '';\n    card('Вне Telegram', 'bad', [['статус', 'Telegram WebApp SDK недоступен']]);\n    note.textContent = 'Откройте страницу кнопкой в Telegram, а не в обычном браузере.';\n    return;\n  }\n  tg.ready();\n  if (tg.expand) { tg.expand(); }\n  try { tg.setHeaderColor('#0d1b2a'); tg.setBackgroundColor('#0d1b2a'); } catch (e) {}\n  try { if (tg.disableClosingConfirmation) { tg.enableClosingConfirmation(); } } catch (e) {}\n\n  // The ONLY place the raw signed context is touched. It is read into a local, placed straight\n  // into each request body, and never written to the DOM, console, storage, cookies or the URL.\n  var initData = tg.initData;\n  if (typeof initData !== 'string' || initData.length === 0) {\n    prog.textContent = '';\n    card('Нет Telegram-контекста', 'bad', [['статус', 'подписанный контекст пуст']]);\n    note.textContent = 'Telegram не передал подписанный контекст. Переоткройте кнопку.';\n    return;\n  }\n  var initDataBytes = initData.length;\n\n  // ONE outbound code path, used by all three shots, so the bytes cannot differ between them.\n  var body = JSON.stringify({ init_data: initData, client_version: CLIENT_VERSION, locale: LOCALE });\n\n  function send() {\n    var t0 = (window.performance && performance.now) ? performance.now() : Date.now();\n    return fetch(ENDPOINT, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      cache: 'no-store',\n      credentials: 'omit',\n      referrerPolicy: 'no-referrer',\n      body: body\n    })\n    .then(function (res) {\n      return res.json()\n        .then(function (d) { return { status: res.status, data: d }; })\n        .catch(function () { return { status: res.status, data: null }; });\n    })\n    .catch(function () { return { status: 0, data: null }; })\n    .then(function (r) {\n      r.ms = Math.round(((window.performance && performance.now) ? performance.now() : Date.now()) - t0);\n      return r;\n    });\n  }\n\n  function render(shot, expected, r, pass) {\n    var d = r.data || {};\n    var leaks = scan(d, [], 0);\n    // A PREFIX only. app_session_id is a session-binding token with a TTL; 16 of its characters\n    // are enough to match this open against its MiniApp_App_Sessions row, and not enough to be\n    // used as one.\n    var prefix = (typeof d.app_session_id === 'string' && d.app_session_id.length)\n      ? (d.app_session_id.substring(0, 16) + '…') : '';\n    card(shot + ' — ' + (pass ? 'PASS' : 'UNEXPECTED'), pass ? 'ok' : 'bad', [\n      ['expected', expected],\n      ['HTTP', r.status === 0 ? 'network error' : r.status],\n      ['ok', String(d.ok)],\n      ['error_code', d.error_code],\n      ['retryable', d.retryable === undefined ? '' : String(d.retryable)],\n      ['app_session_id', prefix],\n      ['session_id_len', typeof d.app_session_id === 'string' ? d.app_session_id.length : ''],\n      ['expires_at', d.expires_at],\n      ['locale', d.locale],\n      ['browser_total_ms', r.ms],\n      ['leak_fields', leaks.length ? leaks.join(',') : '[]']\n    ]);\n    return leaks;\n  }\n\n  var allLeaks = [];\n  var verdict = { a: false, b: false, c: false };\n\n  prog.textContent = 'A — отправляю подписанный контекст…';\n\n  send().then(function (rA) {\n    var dA = rA.data || {};\n    verdict.a = rA.status === 200 && dA.ok === true &&\n                typeof dA.app_session_id === 'string' && dA.app_session_id.length > 0;\n    allLeaks = allLeaks.concat(render('A · ACCEPT', '200 ok:true + app_session_id', rA, verdict.a));\n\n    prog.textContent = 'B — повторяю тот же контекст…';\n    return send().then(function (rB) {\n      var dB = rB.data || {};\n      verdict.b = rB.status === 409 && dB.ok === false && dB.error_code === 'REPLAY_REFUSED';\n      allLeaks = allLeaks.concat(render('B · EXACT REPLAY', '409 REPLAY_REFUSED', rB, verdict.b));\n\n      // ---- C: same context, after the freshness window ----\n      var target = Date.now() + STALE_DELAY_MS;\n      var fired = false;\n      var tick = setInterval(function () {\n        var left = Math.ceil((target - Date.now()) / 1000);\n        if (left > 0) {\n          prog.textContent = 'C — жду истечения окна свежести: ' + left + ' с. Не закрывайте страницу.';\n          return;\n        }\n        if (fired) { return; }\n        fired = true;\n        clearInterval(tick);\n        prog.textContent = 'C — отправляю тот же контекст после истечения окна…';\n        send().then(function (rC) {\n          var dC = rC.data || {};\n          verdict.c = rC.status === 401 && dC.ok === false && dC.error_code === 'TG_INITDATA_EXPIRED';\n          allLeaks = allLeaks.concat(render('C · STALE FRESHNESS', '401 TG_INITDATA_EXPIRED', rC, verdict.c));\n\n          var all = verdict.a && verdict.b && verdict.c && allLeaks.length === 0;\n          prog.textContent = 'Готово.';\n          card('SUMMARY', all ? 'ok' : 'bad', [\n            ['A accept', verdict.a ? 'PASS' : 'FAIL'],\n            ['B exact replay', verdict.b ? 'PASS' : 'FAIL'],\n            ['C stale freshness', verdict.c ? 'PASS' : 'FAIL'],\n            ['initdata_bytes', initDataBytes],\n            ['leak_fields', allLeaks.length ? allLeaks.join(',') : '[]']\n          ]);\n          note.textContent = 'Покажите все карточки. Подписанный контекст нигде не показан и не сохранён — ' +\n            'он существовал только в памяти этой страницы и исчезает при её закрытии.';\n        });\n      }, 1000);\n    });\n  });\n})();\n</script>\n</body>\n</html>\n",
        "options": {
