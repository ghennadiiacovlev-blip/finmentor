    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Resolve the app session from the OPAQUE id alone. No Telegram initData is accepted after\n// bootstrap: the session id IS the credential, and identity is read server-side from the row.\nconst body = $(\"Session Webhook\").first().json.body || {};\nconst id = String(body.app_session_id || \"\").trim();\nif (!/^AS-[0-9a-f]{64}$/.test(id)) { return [{ json: { verdict: 0, error_code: \"BAD_REQUEST\" } }]; }\nreturn [{ json: { verdict: 1, app_session_id: id, step: String(body.step || \"\"), fields: body.fields || {} } }];"
      },
      "id": "pux-resolve-session",
      "name": "Resolve Session",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-session-shape-cond",
              "leftValue": "={{ $json.verdict }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "pux-if-if-session-shape",
      "name": "IF Session Shape",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
