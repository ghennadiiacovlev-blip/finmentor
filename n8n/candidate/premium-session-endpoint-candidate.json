        },
        "filters": {
          "conditions": [
            {
              "keyName": "app_session_id",
              "condition": "eq",
              "keyValue": "={{ $json.app_session_id }}"
            }
          ]
        }
      },
      "id": "pux-read-session",
      "name": "Read App Session",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// TTL and terminal state, decided from the STORED row and the server clock only.\n//\n// `submitted` is terminal: a draft write after a committed submission is refused rather than\n// merged, because the alternative is a client quietly editing a request a consultant already\n// has. That is the same terminal rule the Telegram side enforces.\nconst rows = $input.all().map(i => i.json).filter(r => r && String(r.app_session_id || \"\").trim() !== \"\");\nif (rows.length !== 1) { return [{ json: { ok: 0, error_code: \"SESSION_INVALID\", status: 401 } }]; }\nconst s = rows[0];\n\n// C3 — CUSTOMER PRODUCTION. The owner-only UAT gate that stood here is retired: the cycle is\n// resolved server-side at bootstrap (C3.1), so ownership is the session itself. The session id\n// is a 32-byte secret handed only to the Telegram user whose signed initData the Gateway\n// verified and bound to this row; identity is never read from the caller.\nif (String(s.telegram_user_id || \"\").trim() === \"\") {\n  return [{ json: { ok: 0, error_code: \"SESSION_INVALID\", status: 401 } }];\n}\nif (new Date(String(s.expires_at)).getTime() <= Date.now()) {\n  return [{ json: { ok: 0, error_code: \"SESSION_EXPIRED\", status: 401 } }];\n}\nif (String(s.state) === \"submitted\") { return [{ json: { ok: 0, error_code: \"SUBMIT_IN_PROGRESS\", status: 409 } }]; }\nreturn [{ json: { ok: 1, app_session_id: s.app_session_id, telegram_user_id: s.telegram_user_id, cycle_id: String(s.cycle_id || \"\") } }];"
      },
      "id": "pux-session-verdict",
      "name": "Session Verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "if-session-valid-cond",
              "leftValue": "={{ $json.ok }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "pux-if-if-session-valid",
      "name": "IF Session Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
